<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_app_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrackinApp"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TrackinApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".screens.WelcomeScreen"
            android:exported="true">
        </activity>

        <activity
            android:name=".screens.LanguagesScreen"
            android:exported="true">
        </activity>

        <activity
            android:name=".screens.LoginScreen"
            android:exported="true">
        </activity>

        <activity
            android:name=".screens.HomeScreen"
            android:exported="true">
        </activity>

        <activity
            android:name=".screens.GroupScreen"
            android:exported="true">
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true">
        </activity>
        <activity
            android:name=".groupmanagement.CreateGroup"
            android:exported="true">
        </activity>
        <activity
            android:name=".groupmanagement.JoinGroup"
            android:exported="true">
        </activity>


        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

    </application>

</manifest>